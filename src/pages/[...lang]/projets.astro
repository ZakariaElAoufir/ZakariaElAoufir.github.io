---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projectText, publishedProjects } from '../../lib/projects';
import { langPaths, localePath, pick, toLang, useTranslations, type Key } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const typeLabel: Record<string, Key> = { stage: 'projects.typeStage', personnel: 'projects.typePersonnel', academique: 'projects.typeAcademique' };
const rows = await Promise.all((await publishedProjects()).map(async project => ({
  project,
  Text: (await render(await projectText(project.id, lang))).Content
})));
---
<BaseLayout lang={lang} title={t('meta.projectsTitle')} description={t('meta.projectsDescription')}>
  <section class="block intro">
    <div class="instant">
      <h1 class="big reveal">{t('projects.title')}</h1>
      <p class="lead reveal" style="--d:150ms">{t('projects.lead')}</p>
      <div class="legend reveal" style="--d:250ms">
        <span class="type stage">{t('projects.legendStage')}</span>
        <span class="type personnel">{t('projects.legendPersonnel')}</span>
        <span class="type academique">{t('projects.legendAcademique')}</span>
      </div>
    </div>

    {rows.length === 0 && <p class="empty px-frame">{t('projects.empty')}</p>}

    <div class="list">
      {rows.map(({ project: { id, data }, Text }) => {
        const demo = data.hasDemo ? localePath(lang, `/projets/${id}/`) : null;
        const Shot = demo ? 'a' : 'div';
        return (
          <article class="row px-frame" id={id}>
            <Shot class="shot reveal from-left" href={demo ?? undefined} aria-label={demo ? `${t('projects.seeDemo')} : ${pick(data.title, lang)}` : undefined}>
              <span class="art"></span>
              <strong>{pick(data.shortTitle, lang)}</strong>
              {demo && <span class="cue"><Icon name="play" />{t('projects.seeDemo')}</span>}
            </Shot>
            <div class="info reveal from-right">
              <div class="tags">
                <span class={`type ${data.type}`}>
                  {t(typeLabel[data.type])}{data.company && ` · ${data.company}`}{data.pair && ` · ${t('projects.pair')}`}
                </span>
                <span class="date"><Icon name="calendar" />{pick(data.period, lang)}</span>
              </div>
              <h2>{pick(data.title, lang)}</h2>
              <div class="text"><Text /></div>
              <div class="chips">{data.stack.map(s => <span>{s}</span>)}</div>
              <div class="links">
                {demo && <a class="btn small" href={demo}><Icon name="play" />{t('projects.demo')}</a>}
                {data.hasDemo && <a class="btn small ghost" href={localePath(lang, `/projets/${id}/architecture/`)}><Icon name="layers" />{t('projects.architecture')}</a>}
                {data.repo
                  ? <a class="btn small ghost" href={data.repo}><Icon name="code" />{t('projects.code')}</a>
                  : <span class="private"><Icon name="lock" />{t('projects.private')}</span>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .intro { padding-top: 150px; }
  .lead { max-width: 60ch; font-size: 19px; margin-top: -24px; }
  .legend { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .empty { margin-top: 64px; padding: 40px; background: var(--deep); text-align: center; color: var(--ash); }

  /* one project per row: the picture on the left, everything to read on the right */
  .list { display: grid; gap: 36px; margin-top: 64px; overflow-x: clip; }
  .row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); background: var(--deep); scroll-margin-top: 100px; }
  .row:hover, .row:target { background: var(--raise); --frame: var(--accent-text); }

  .shot { position: relative; display: block; min-height: 300px; overflow: hidden; background: var(--night); }
  .art { position: absolute; inset: 0; transition: transform 1.1s var(--ease), filter .6s;
    background:
      linear-gradient(90deg, transparent 0 47%, var(--deep) 47% 53%, transparent 53%),
      repeating-linear-gradient(90deg, rgba(80, 80, 220, .16) 0 8%, transparent 8% 12%),
      repeating-linear-gradient(0deg, var(--night) 0 5%, transparent 5% 12%); }
  .shot strong { position: absolute; left: 28px; right: 28px; bottom: 26px; font: 700 clamp(26px, 2.6vw, 38px)/1 var(--display); text-transform: uppercase; transition: transform .6s var(--ease); }
  .shot::before { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(105deg, transparent 35%, rgba(232, 232, 250, .16) 50%, transparent 65%); transform: translateX(-110%); transition: transform 1s var(--ease); }
  .cue { position: absolute; z-index: 2; top: 50%; left: 50%; display: inline-flex; align-items: center; gap: 10px; padding: 12px 18px; background: var(--accent); clip-path: var(--pix); font: 700 16px/1 var(--display); letter-spacing: .04em; text-transform: uppercase; opacity: 0; transform: translate(-50%, -30%); transition: opacity .4s, transform .5s var(--ease); }
  .row:hover .art { transform: scale(1.08); filter: brightness(.6); }
  .row:hover .shot::before { transform: translateX(110%); }
  .row:hover .shot strong { transform: translateY(-6px); }
  .row:hover .cue, .shot:focus-visible .cue { opacity: 1; transform: translate(-50%, -50%); }

  .info { padding: 40px 44px; display: flex; flex-direction: column; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .type { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; font: 600 15px/1 var(--display); letter-spacing: .04em; text-transform: uppercase; clip-path: var(--pix); }
  .type.stage { background: var(--accent); }
  .type.personnel { background: var(--ivory); color: var(--night); }
  .type.academique { background: var(--raise); box-shadow: inset 0 0 0 4px var(--line); }
  .date { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; color: var(--ash); }
  h2 { font: 700 clamp(24px, 2.4vw, 32px)/1.1 var(--display); text-transform: uppercase; margin: 18px 0 14px; }
  .text { color: var(--ash); max-width: 64ch; display: grid; gap: 10px; }
  .text :global(strong) { color: var(--ivory); font-weight: 500; }
  .info .links { margin-top: auto; padding-top: 26px; gap: 12px; }

  @media (max-width: 960px) {
    .row { grid-template-columns: 1fr; }
    .js .reveal.from-left, .js .reveal.from-right { transform: translateY(32px); }
    .js .reveal.is-in { transform: none; }
    .shot { min-height: 220px; }
    .cue { opacity: 1; top: 22px; left: auto; right: 18px; transform: none; }
    .row:hover .cue { transform: none; }
    .info { padding: 28px 22px; }
  }
</style>
