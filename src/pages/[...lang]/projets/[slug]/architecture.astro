---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ProjectHeader from '../../../../components/project/ProjectHeader.astro';
import ArchOverview from '../../../../components/project/ArchOverview.astro';
import Icon from '../../../../components/Icon.astro';
import { architectureOf, demoProjects, diagramSvg, type Project } from '../../../../lib/projects';
import { languages, pick, useTranslations, type Lang } from '../../../../i18n/utils';

export async function getStaticPaths() {
  const projects = await demoProjects();
  return languages.flatMap(lang => projects.map(project => ({
    params: { lang: lang === 'fr' ? undefined : lang, slug: project.id },
    props: { lang, project }
  })));
}

interface Props { lang: Lang; project: Project }
const { lang, project } = Astro.props;
const t = useTranslations(lang);
const arch = await architectureOf(project.id);
const name = pick(project.data.shortTitle, lang);

const sections = [
  { id: 'vue', label: t('arch.overview') },
  { id: 'stack', label: t('arch.stack') },
  ...arch.diagrams.map(d => ({ id: d.id, label: pick(d.title, lang) })),
  { id: 'choix', label: t('arch.choices') },
  { id: 'limites', label: t('arch.limitsAndNext') },
  ...(arch.credits ? [{ id: 'origine', label: t('arch.credits') }] : [])
];
---
<BaseLayout lang={lang} title={t('meta.architectureTitle', { name })} description={t('arch.overviewTitle', { name })}>
  <section class="block intro">
    <ProjectHeader lang={lang} project={project} current="architecture" />

    <div class="arch">
      <nav class="menu" aria-label={t('arch.menu')}>
        {sections.map((s, i) => <a href={`#${s.id}`} class:list={{ on: i === 0 }}>{s.label}</a>)}
      </nav>

      <div class="panels">
        <section class="panel" id="vue">
          <figure class="diagram px-frame" data-title={t('arch.overview')}>
            <header><h2>{t('arch.overview')}</h2><button class="btn small ghost zoom"><Icon name="layers" />{t('arch.zoom')}</button></header>
            <div class="canvas"><ArchOverview lang={lang} overview={arch.overview} title={t('arch.overviewTitle', { name })} /></div>
            <figcaption>{arch.overview.caption ? pick(arch.overview.caption, lang) : t('arch.overviewCaption')}</figcaption>
            {arch.overview.mineLabel && (
              <p class="legend"><span><i></i>{pick(arch.overview.mineLabel, lang)}</span></p>
            )}
          </figure>
        </section>

        <section class="panel" id="stack">
          <h2 class="sub">{t('arch.stack')}</h2>
          <div class="stack">
            {arch.stack.map(group => (
              <article class="px-frame">
                <h3>{pick(group.name, lang)}</h3>
                <ul>{group.items.map(item => (
                  <li><i style={`--logo:url(/logos/${item.logo}.svg)`}></i>{item.name}{item.note && <span>{pick(item.note, lang)}</span>}</li>
                ))}</ul>
              </article>
            ))}
          </div>
        </section>

        {arch.diagrams.map(d => (
          <section class="panel" id={d.id}>
            <figure class="diagram px-frame" data-title={pick(d.title, lang)}>
              <header><h2>{pick(d.title, lang)}</h2><button class="btn small ghost zoom"><Icon name="layers" />{t('arch.zoom')}</button></header>
              <div class="canvas mermaid" set:html={diagramSvg(project.id, d.id, lang)} />
              <figcaption>{pick(d.caption, lang)}</figcaption>
            </figure>
          </section>
        ))}

        <section class="panel" id="choix">
          <h2 class="sub">{t('arch.choices')}</h2>
          <div class="choices">
            {arch.choices.map(c => (
              <article class="px-frame">
                <h3>{pick(c.title, lang)}</h3>
                <dl>
                  <dt>{t('arch.why')}</dt><dd>{pick(c.why, lang)}</dd>
                  <dt>{t('arch.alternative')}</dt><dd>{pick(c.alternative, lang)}</dd>
                  <dt>{t('arch.tradeoff')}</dt><dd>{pick(c.tradeoff, lang)}</dd>
                </dl>
              </article>
            ))}
          </div>
        </section>

        <section class="panel" id="limites">
          <h2 class="sub">{t('arch.limitsAndNext')}</h2>
          <div class="limits">
            <article class="px-frame"><h3>{t('arch.limits')}</h3><ul>{arch.limits[lang].map(l => <li>{l}</li>)}</ul></article>
            <article class="px-frame"><h3>{t('arch.next')}</h3><ul>{arch.next[lang].map(l => <li>{l}</li>)}</ul></article>
          </div>
        </section>

        {arch.credits && (
          <section class="panel" id="origine">
            <h2 class="sub">{t('arch.credits')}</h2>
            <article class="credits px-frame"><ul>{arch.credits[lang].map(l => <li>{l}</li>)}</ul></article>
          </section>
        )}
      </div>
    </div>
  </section>

  <div class="full" id="full" role="dialog" aria-modal="true" hidden>
    <div class="bar"><span id="full-title"></span><button class="btn small" id="full-close">{t('arch.close')}</button></div>
    <div class="body" id="full-body"></div>
  </div>
</BaseLayout>

<script>
  // one section at a time, picked in the menu; the address keeps it so a link can open a given section
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.menu a')];
  const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
  const show = (id: string) => {
    if (!panels.some(p => p.id === id)) id = panels[0].id;
    panels.forEach(p => p.classList.toggle('on', p.id === id));
    links.forEach(l => l.classList.toggle('on', l.hash === `#${id}`));
    const active = links.find(l => l.classList.contains('on'));
    if (active) active.parentElement!.scrollLeft = active.offsetLeft - 16;   // phone: the menu scrolls sideways, never the page
  };
  links.forEach(l => l.addEventListener('click', e => { e.preventDefault(); history.replaceState(null, '', l.hash); show(l.hash.slice(1)); }));
  show(location.hash.slice(1));
  document.querySelector('.panels')!.classList.add('ready');

  // any diagram can open full screen, at full size, to read it on a phone
  const full = document.getElementById('full')!;
  const close = () => { full.hidden = true; document.body.style.overflow = ''; };
  document.querySelectorAll<HTMLButtonElement>('.zoom').forEach(button => button.addEventListener('click', () => {
    const figure = button.closest<HTMLElement>('.diagram')!;
    document.getElementById('full-title')!.textContent = figure.dataset.title!;
    document.getElementById('full-body')!.replaceChildren(figure.querySelector('.canvas > svg')!.cloneNode(true));
    full.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('full-close')!.focus();
  }));
  document.getElementById('full-close')!.addEventListener('click', close);
  addEventListener('keydown', e => { if (e.key === 'Escape' && !full.hidden) close(); });
</script>

<style>
  .intro { padding-top: 140px; }
  /* the page works like a small app: a menu on the left, one section at a time */
  .arch { --w: min(1720px, calc(100vw - 2 * var(--margin))); width: var(--w); margin-left: calc((100% - var(--w)) / 2);
    display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 32px; margin-top: 56px; align-items: start; }
  .menu { position: sticky; top: 110px; display: grid; gap: 8px; }
  .menu a { padding: 12px 16px 13px; font: 600 15px/1.2 var(--display); text-transform: uppercase; letter-spacing: .03em; background: var(--deep); color: var(--ash); clip-path: var(--pix); transition: background .2s, color .2s; }
  .menu a:hover { background: var(--raise); color: var(--ivory); }
  .menu a.on { background: var(--accent); color: var(--ivory); box-shadow: inset 0 -4px 0 var(--accent-dark); }
  .panel + .panel { margin-top: 48px; }
  .panels.ready .panel { display: none; }
  .panels.ready .panel.on { display: block; animation: show .45s var(--ease); }
  .panels.ready .panel + .panel { margin-top: 0; }
  @keyframes show { from { opacity: 0; transform: translateY(12px); } }

  .sub { font: 700 clamp(26px, 3vw, 38px)/1.1 var(--display); text-transform: uppercase; text-shadow: 3px 3px 0 var(--accent-dark); margin-bottom: 26px; }
  .diagram { margin: 0; background: var(--deep); padding: 24px 26px 22px; }
  .diagram header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .diagram h2 { font: 700 22px/1.2 var(--display); text-transform: uppercase; }
  .canvas { margin-top: 18px; padding: 18px 10px; background: var(--night); overflow-x: auto; }
  .canvas.mermaid :global(svg) { display: block; margin: 0 auto; max-width: 100%; height: auto; }
  figcaption { margin-top: 14px; color: var(--ash); max-width: 80ch; }
  .legend { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 12px; font-size: 15px; color: var(--ash); }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 22px; height: 16px; background: var(--raise); box-shadow: inset 0 0 0 3px var(--accent-text); }

  .stack { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .stack article, .choices article, .limits article { background: var(--deep); padding: 22px 24px 24px; }
  h3 { font: 700 19px/1.2 var(--display); text-transform: uppercase; margin-bottom: 14px; }
  .stack h3 { color: var(--accent-text); font-size: 17px; }
  .stack ul { list-style: none; padding: 0; display: grid; gap: 10px; }
  .stack li { display: flex; align-items: center; gap: 10px; }
  .stack li i { width: 22px; height: 22px; flex: none; background: var(--accent-text); -webkit-mask: var(--logo) center / contain no-repeat; mask: var(--logo) center / contain no-repeat; }
  .stack li span { color: var(--ash); font-size: 14px; }
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  dl { display: grid; gap: 10px; margin: 0; }
  dt { font: 600 14px/1 var(--display); text-transform: uppercase; letter-spacing: .04em; color: var(--accent-text); }
  dd { margin: 0; color: var(--ash); }
  .limits { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .limits ul { padding-left: 20px; display: grid; gap: 8px; color: var(--ash); list-style: square; }
  .limits li::marker, .credits li::marker { color: var(--accent-text); }
  .credits { background: var(--deep); padding: 22px 24px; }
  .credits ul { padding-left: 20px; display: grid; gap: 8px; color: var(--ash); list-style: square; }

  .full { position: fixed; inset: 0; z-index: 80; display: flex; flex-direction: column; background: rgba(18, 18, 47, .97); padding: 16px; }
  .full[hidden] { display: none; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 12px; font: 700 18px/1.2 var(--display); text-transform: uppercase; }
  .full .body { flex: 1; overflow: auto; background: var(--night); padding: 16px; }
  .full .body :global(svg) { width: max(1300px, 100%); max-width: none; height: auto; }

  @media (max-width: 960px) {
    .arch { grid-template-columns: 1fr; gap: 20px; margin-top: 36px; }
    .menu { position: sticky; top: 72px; z-index: 5; display: flex; overflow-x: auto; gap: 8px; padding: 10px 0; background: var(--night); }
    .menu a { flex: none; font-size: 14px; }
    .stack, .choices, .limits { grid-template-columns: 1fr; }
    .diagram { padding: 20px 16px; }
  }
</style>
