erDiagram
  PROFILES ||--o{ PUBLICATIONS : publie
  PROFILES ||--o{ PUBLICATION_LIKES : aime
  PUBLICATIONS ||--o{ PUBLICATION_LIKES : recoit
  PROFILES ||--o{ FRIENDS : "a pour ami"
  PROFILES ||--o{ FOLLOW_REQUESTS : "envoie, recoit"
  PROFILES ||--o{ MESSAGES : "envoie, recoit"
  PROFILES {
    uuid id PK "= auth.users.id"
    text username
    text nom
    text prenom
    text email
    bool online
    text avatar_url
    timestamptz created
  }
  PUBLICATIONS {
    uuid id PK
    uuid profile_id FK
    text content
    text image
    int likes
    timestamptz created_at
  }
  PUBLICATION_LIKES {
    uuid id PK
    uuid publication_id FK
    uuid profile_id FK
  }
  FRIENDS {
    uuid id PK
    uuid user_id FK
    uuid friend_id FK
    timestamptz created_at
  }
  FOLLOW_REQUESTS {
    uuid id PK
    uuid sender_id FK
    uuid receiver_id FK
    text status "pending"
    timestamptz created_at
  }
  MESSAGES {
    uuid id PK
    uuid sender_id FK
    uuid receiver_id FK
    text content
    text image_url
    bool seen
    timestamptz created_at
  }
