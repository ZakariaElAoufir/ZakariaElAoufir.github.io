  "diagrams": [
    {
      "id": "revue",
      "title": {
        "fr": "D'un livrable à la validation",
        "en": "From deliverable to validation"
      },
      "caption": {
        "fr": "Le stagiaire dépose un fichier ou un commit. L'encadrant peut demander l'avis de l'IA, mais c'est lui qui décide. La mission se complète seule quand la dernière preuve de chaque membre est acceptée, et l'équipe reçoit ses points une seule fois.",
        "en": "The intern hands in a file or a commit. The supervisor can ask the AI's opinion, but makes the decision. The mission completes itself once every member's latest proof is accepted, and the team is paid only once."
      }
    },
    {
      "id": "assistant",
      "title": {
        "fr": "L'assistant de mission",
        "en": "The mission assistant"
      },
      "caption": {
        "fr": "Le document de consigne est découpé puis indexé une seule fois. À chaque question, les passages les plus proches sont retrouvés et envoyés au modèle local avec le contexte de la mission. Une question hors sujet est refusée.",
        "en": "The instruction document is cut and indexed only once. For each question, the closest passages are found and sent to the local model with the mission context. An off-topic question is declined."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Le modèle du service des stages",
        "en": "The internship service's model"
      },
      "caption": {
        "fr": "Une équipe réserve des places par poste : c'est team_position_slots qui empêche de dépasser la capacité. Les missions portent les preuves (livrables et commits), dont chaque revue est conservée.",
        "en": "A team holds seats per position: team_position_slots is what prevents going over capacity. Missions carry the proofs (deliverables and commits), and every review is kept."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Une base par service",
        "en": "One database per service"
      },
      "why": {
        "fr": "Chaque service garde la main sur ses tables : le service des stages évolue sans toucher aux comptes ni à la gamification.",
        "en": "Each service owns its tables: the internship service evolves without touching accounts or gamification."
      },
      "alternative": {
        "fr": "Une base unique partagée, avec des jointures.",
        "en": "A single shared database, with joins."
      },
      "tradeoff": {
        "fr": "Les informations d'une personne se récupèrent par appels entre services.",
        "en": "A person's details have to be fetched through calls between services."
      }
    },
    {
      "title": {
        "fr": "L'identité vérifiée une seule fois",
        "en": "Identity checked only once"
      },
      "why": {
        "fr": "La gateway vérifie le JWT et transmet l'identité aux services. Le code métier lit simplement qui appelle.",
        "en": "The gateway checks the JWT and passes the identity to the services. Business code simply reads who is calling."
      },
      "alternative": {
        "fr": "Faire valider le jeton par chaque service.",
        "en": "Having every service validate the token."
      },
      "tradeoff": {
        "fr": "Les services doivent rester joignables uniquement à travers la gateway.",
        "en": "Services must stay reachable only through the gateway."
      }
    },
    {
      "title": {
        "fr": "Kafka pour les effets secondaires",
        "en": "Kafka for side effects"
      },
      "why": {
        "fr": "Une mission validée déclenche points et notifications sans ralentir la réponse à l'encadrant.",
        "en": "A validated mission triggers points and notifications without slowing the answer to the supervisor."
      },
      "alternative": {
        "fr": "Appeler directement la gamification et les notifications.",
        "en": "Calling gamification and notifications directly."
      },
      "tradeoff": {
        "fr": "Les points et les alertes arrivent avec un léger décalage.",
        "en": "Points and alerts arrive with a slight delay."
      }
    },
    {
      "title": {
        "fr": "Une IA locale avec Ollama",
        "en": "A local AI with Ollama"
      },
      "why": {
        "fr": "Les consignes et les livrables restent sur nos serveurs : aucune donnée de stage ne part vers un service externe.",
        "en": "Instructions and deliverables stay on our servers: no internship data goes to an external service."
      },
      "alternative": {
        "fr": "Une API d'IA hébergée, plus puissante.",
        "en": "A hosted AI API, more powerful."
      },
      "tradeoff": {
        "fr": "Un modèle léger, qui donne des réponses plus simples.",
        "en": "A lightweight model, giving simpler answers."
      }
    },
    {
      "title": {
        "fr": "RAG sur les consignes de la mission",
        "en": "RAG on the mission's instructions"
      },
      "why": {
        "fr": "L'assistant répond à partir du document de la mission et sait dire quand une question sort du sujet.",
        "en": "The assistant answers from the mission's document and can tell when a question is off topic."
      },
      "alternative": {
        "fr": "Envoyer le document entier à chaque question.",
        "en": "Sending the whole document with every question."
      },
      "tradeoff": {
        "fr": "Une indexation à faire au premier usage de chaque document.",
        "en": "Indexing to do the first time each document is used."
      }
    },
    {
      "title": {
        "fr": "L'IA recommande, l'encadrant décide",
        "en": "The AI recommends, the supervisor decides"
      },
      "why": {
        "fr": "La vérification d'un livrable propose un verdict et un commentaire, mais ne change jamais un statut.",
        "en": "Checking a deliverable suggests a verdict and a comment, but never changes a status."
      },
      "alternative": {
        "fr": "Accepter ou refuser automatiquement les livrables.",
        "en": "Accepting or rejecting deliverables automatically."
      },
      "tradeoff": {
        "fr": "Une action humaine reste nécessaire pour chaque livrable.",
        "en": "A human action is still needed for each deliverable."
      }
    },
    {
      "title": {
        "fr": "Une GitHub App avec webhooks",
        "en": "A GitHub App with webhooks"
      },
      "why": {
        "fr": "L'équipe autorise ses dépôts une fois, et les commits arrivent d'eux-mêmes sur la plateforme.",
        "en": "The team authorises its repositories once, and commits reach the platform by themselves."
      },
      "alternative": {
        "fr": "Des jetons personnels et une interrogation régulière de GitHub.",
        "en": "Personal tokens and regular polling of GitHub."
      },
      "tradeoff": {
        "fr": "Une application à installer sur l'organisation GitHub de l'équipe.",
        "en": "An app to install on the team's GitHub organisation."
      }
    }
  ],
  "limits": {
    "fr": [
      "Le modèle local est volontairement léger : ses réponses restent simples.",
      "L'assistant ne s'appuie que sur les documents de la mission.",
      "Sous Docker Compose, chaque service tourne en une seule instance."
    ],
    "en": [
      "The local model is deliberately light: its answers stay simple.",
      "The assistant relies only on the mission's documents.",
      "Under Docker Compose, each service runs as a single instance."
    ]
  },
  "next": {
    "fr": [
      "Essayer un modèle plus puissant sur une machine dotée d'un GPU.",
      "Faire comparer par l'IA le rapport et les commits soumis.",
      "Afficher à l'encadrant une vue de l'avancement sur plusieurs promotions."
    ],
    "en": [
      "Try a more powerful model on a machine with a GPU.",
      "Have the AI compare the report with the submitted commits.",
      "Give supervisors a progress view across several intakes."
    ]
  }
}
