  "diagrams": [
    {
      "id": "releve",
      "title": {
        "fr": "Parcours d'un relevé",
        "en": "Journey of a reading"
      },
      "caption": {
        "fr": "Le relevé ne fait que passer par ingestion-service : Kafka découple la réception, qui encaisse 1 000 relevés toutes les 5 secondes, du stockage et du calcul des alertes, faits par usage-service à son rythme.",
        "en": "A reading only passes through ingestion-service: Kafka decouples reception, which takes 1,000 readings every 5 seconds, from storage and alert computation, done by usage-service at its own pace."
      }
    },
    {
      "id": "securite",
      "title": {
        "fr": "Requête sécurisée",
        "en": "Secured request"
      },
      "caption": {
        "fr": "Seule la gateway est exposée : elle valide le JWT émis par Keycloak, puis route vers le service. Si un service tombe, le circuit breaker Resilience4j répond par une route de secours au lieu d'attendre.",
        "en": "Only the gateway is exposed: it validates the JWT issued by Keycloak, then routes to the service. If a service goes down, the Resilience4j circuit breaker answers with a fallback route instead of waiting."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Modèle de données",
        "en": "Data model"
      },
      "caption": {
        "fr": "Schéma MySQL créé par les migrations Flyway de user-service. Les relevés, eux, vont dans InfluxDB (mesure energy_usage, tag deviceId, champ energyConsumed).",
        "en": "MySQL schema created by user-service's Flyway migrations. Readings go to InfluxDB instead (measurement energy_usage, tag deviceId, field energyConsumed)."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Kafka entre ingestion et usage",
        "en": "Kafka between ingestion and usage"
      },
      "why": {
        "fr": "La réception des relevés ne dépend plus du stockage : si usage-service ralentit, les messages attendent dans le topic.",
        "en": "Receiving readings no longer depends on storage: if usage-service slows down, messages wait in the topic."
      },
      "alternative": {
        "fr": "Des appels REST directs d'ingestion vers usage.",
        "en": "Direct REST calls from ingestion to usage."
      },
      "tradeoff": {
        "fr": "Un broker de plus à faire tourner, et des événements à garder compatibles des deux côtés.",
        "en": "One more broker to run, and events to keep compatible on both sides."
      }
    },
    {
      "title": {
        "fr": "InfluxDB pour les relevés",
        "en": "InfluxDB for readings"
      },
      "why": {
        "fr": "Base de séries temporelles : écritures massives et sommes par fenêtre de temps (Flux) sans index à gérer.",
        "en": "A time-series database: heavy writes and sums over time windows (Flux) without managing indexes."
      },
      "alternative": {
        "fr": "Une table MySQL de relevés.",
        "en": "A MySQL table of readings."
      },
      "tradeoff": {
        "fr": "Deux bases à maintenir ; le langage Flux est spécifique.",
        "en": "Two databases to maintain; Flux is a language of its own."
      }
    },
    {
      "title": {
        "fr": "Gateway + Keycloak",
        "en": "Gateway + Keycloak"
      },
      "why": {
        "fr": "Un seul point d'entrée sécurisé par JWT ; les services restent simples, derrière. Circuit breaker par route.",
        "en": "A single entry point secured by JWT; the services behind it stay simple. A circuit breaker per route."
      },
      "alternative": {
        "fr": "Valider le jeton dans chaque service.",
        "en": "Validating the token in every service."
      },
      "tradeoff": {
        "fr": "La gateway devient un point critique ; le realm Keycloak se configure à la main.",
        "en": "The gateway becomes a critical point; the Keycloak realm is set up by hand."
      }
    },
    {
      "title": {
        "fr": "IA locale avec Spring AI",
        "en": "Local AI with Spring AI"
      },
      "why": {
        "fr": "Les conseils sont générés sans envoyer les données de consommation à un service externe.",
        "en": "Tips are generated without sending consumption data to an external service."
      },
      "alternative": {
        "fr": "Une API hébergée (OpenAI, Mistral).",
        "en": "A hosted API (OpenAI, Mistral)."
      },
      "tradeoff": {
        "fr": "Qualité limitée par le modèle local choisi.",
        "en": "Quality is limited by the local model chosen."
      }
    },
    {
      "title": {
        "fr": "Prometheus + Grafana",
        "en": "Prometheus + Grafana"
      },
      "why": {
        "fr": "Chaque service expose ses métriques ; le tableau de bord est provisionné au démarrage, sans clic.",
        "en": "Every service exposes its metrics; the dashboard is provisioned at startup, with no clicks."
      },
      "alternative": {
        "fr": "Les seuls logs des services.",
        "en": "The services' logs alone."
      },
      "tradeoff": {
        "fr": "Deux conteneurs de plus en local.",
        "en": "Two more containers to run locally."
      }
    }
  ],
  "limits": {
    "fr": [
      "Tant que le seuil est dépassé, une alerte repart toutes les 10 secondes : pas de déduplication.",
      "L'agrégation appelle device-service puis user-service pour chaque appareil (beaucoup d'appels REST).",
      "Le simulateur tire des identifiants d'appareils au hasard, y compris inexistants.",
      "Jeton InfluxDB et mots de passe écrits dans la configuration.",
      "Swagger agrégé : seule la documentation de user-service est branchée à la gateway."
    ],
    "en": [
      "While the threshold is exceeded, an alert goes out again every 10 seconds: no deduplication.",
      "Aggregation calls device-service then user-service for every device (many REST calls).",
      "The simulator picks random device ids, including ones that do not exist.",
      "InfluxDB token and passwords are written in the configuration.",
      "Aggregated Swagger: only user-service's documentation is wired to the gateway."
    ]
  },
  "next": {
    "fr": [
      "Mémoriser la dernière alerte envoyée par utilisateur.",
      "Mettre en cache les propriétaires d'appareils et les seuils.",
      "Secrets en variables d'environnement, realm Keycloak exporté.",
      "Une interface web pour les utilisateurs."
    ],
    "en": [
      "Remember the last alert sent per user.",
      "Cache device owners and thresholds.",
      "Secrets in environment variables, exported Keycloak realm.",
      "A web interface for users."
    ]
  },
  "credits": {
    "fr": [
      "Projet inspiré de la problématique de suivi d'énergie en microservices présentée par LeetJourney."
    ],
    "en": [
      "Project inspired by the microservices energy-tracking problem presented by LeetJourney."
    ]
  }
}
