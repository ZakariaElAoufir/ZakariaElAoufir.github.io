  "diagrams": [
    {
      "id": "reservation",
      "title": {
        "fr": "Réserver un créneau",
        "en": "Booking a slot"
      },
      "caption": {
        "fr": "Le créneau est relu juste avant d'écrire : s'il vient d'être pris, la réservation s'arrête. Sinon, le rendez-vous et le créneau sont écrits dans une seule transaction Room.",
        "en": "The slot is read again just before writing: if it was just taken, booking stops. Otherwise the appointment and the slot are written in a single Room transaction."
      }
    },
    {
      "id": "rappel",
      "title": {
        "fr": "Rappel au patient",
        "en": "Reminder to the patient"
      },
      "caption": {
        "fr": "Le rappel est d'abord une ligne dans la table notifications, que le patient retrouve dans l'application ; il devient aussi une notification Android si la permission est accordée.",
        "en": "The reminder is first a row in the notifications table, which the patient finds in the app; it also becomes an Android notification when the permission is granted."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Modèle de données",
        "en": "Data model"
      },
      "caption": {
        "fr": "Une seule table pour les trois rôles. Les clés étrangères suppriment en cascade : supprimer un médecin supprime ses créneaux et ses rendez-vous.",
        "en": "One table for the three roles. Foreign keys cascade: deleting a doctor deletes their slots and appointments."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Room plutôt que SQLite à la main",
        "en": "Room rather than raw SQLite"
      },
      "why": {
        "fr": "Requêtes vérifiées à la compilation, entités annotées et transactions sans code de curseur.",
        "en": "Queries checked at compile time, annotated entities and transactions without cursor code."
      },
      "alternative": {
        "fr": "SQLiteOpenHelper et des Cursor.",
        "en": "SQLiteOpenHelper and Cursors."
      },
      "tradeoff": {
        "fr": "Chaque appel doit partir sur un autre thread que celui de l’interface.",
        "en": "Every call must run on a thread other than the UI one."
      }
    },
    {
      "title": {
        "fr": "Réservation en transaction",
        "en": "Booking in a transaction"
      },
      "why": {
        "fr": "Le rendez-vous et le créneau réservé sont écrits ensemble : jamais l'un sans l'autre.",
        "en": "The appointment and the booked slot are written together: never one without the other."
      },
      "alternative": {
        "fr": "Deux écritures séparées.",
        "en": "Two separate writes."
      },
      "tradeoff": {
        "fr": "Un peu plus de code autour de runInTransaction.",
        "en": "A little more code around runInTransaction."
      }
    },
    {
      "title": {
        "fr": "Une table pour tous les rôles",
        "en": "One table for every role"
      },
      "why": {
        "fr": "Connexion unique par e-mail ; le rôle décide du tableau de bord ouvert.",
        "en": "One sign-in by e-mail; the role decides which dashboard opens."
      },
      "alternative": {
        "fr": "Une table par profil.",
        "en": "One table per profile."
      },
      "tradeoff": {
        "fr": "Des colonnes vides selon le rôle (spécialité, antécédents).",
        "en": "Empty columns depending on the role (speciality, history)."
      }
    },
    {
      "title": {
        "fr": "LiveData pour le badge",
        "en": "LiveData for the badge"
      },
      "why": {
        "fr": "Le compteur de notifications non lues se met à jour seul quand la table change.",
        "en": "The unread counter updates itself when the table changes."
      },
      "alternative": {
        "fr": "Recompter à chaque ouverture.",
        "en": "Counting again on every visit."
      },
      "tradeoff": {
        "fr": "Un observateur lié au cycle de vie de l’écran.",
        "en": "An observer tied to the screen lifecycle."
      }
    }
  ],
  "limits": {
    "fr": [
      "Les données restent sur l'appareil : pas encore de synchronisation entre plusieurs téléphones.",
      "Les rappels sont envoyés à la main par le médecin, pas encore programmés.",
      "Dates et heures se saisissent au clavier, sans sélecteur de date.",
      "Les notes de consultation existent dans la base mais n'ont pas encore d'écran."
    ],
    "en": [
      "Data stays on the device: no sync between several phones yet.",
      "Reminders are sent by hand by the doctor, not scheduled yet.",
      "Dates and times are typed in, with no date picker.",
      "Consultation notes exist in the database but have no screen yet."
    ]
  },
  "next": {
    "fr": [
      "Une API (Spring Boot) pour partager les rendez-vous entre les téléphones du patient et du médecin.",
      "Des rappels programmés la veille avec WorkManager.",
      "Des sélecteurs de date et d'heure Material.",
      "Un écran de notes de consultation pour le médecin."
    ],
    "en": [
      "An API (Spring Boot) to share appointments between the patient's and the doctor's phones.",
      "Reminders scheduled the day before with WorkManager.",
      "Material date and time pickers.",
      "A consultation notes screen for doctors."
    ]
  }
}