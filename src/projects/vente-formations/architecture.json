  "diagrams": [
    {
      "id": "panier",
      "title": {
        "fr": "Ajouter au panier",
        "en": "Adding to the cart"
      },
      "caption": {
        "fr": "Le bouton envoie une requête AJAX ; la vue ajoute l'identifiant et le prix dans la session, une seule fois par formation, puis recopie tout le panier dans le profil si l'utilisateur est connecté.",
        "en": "The button sends an AJAX request; the view adds the id and the price to the session, once per course, then copies the whole cart into the profile when the user is signed in."
      }
    },
    {
      "id": "connexion",
      "title": {
        "fr": "Retrouver son panier",
        "en": "Getting the cart back"
      },
      "caption": {
        "fr": "À la connexion, Django change la clé de session sans perdre son contenu ; la vue relit le panier enregistré dans le profil et le fusionne avec celui de la session.",
        "en": "At sign-in, Django changes the session key without losing its content; the view reads the cart saved in the profile and merges it with the session's one."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Modèle de données",
        "en": "Data model"
      },
      "caption": {
        "fr": "Le profil complète l'utilisateur de Django et garde le panier enregistré. Chaque formation appartient à un formateur ; les réservations sont prêtes dans le modèle.",
        "en": "The profile extends Django's user and keeps the saved cart. Each course belongs to a trainer; bookings are ready in the model."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Panier en session",
        "en": "Cart in the session"
      },
      "why": {
        "fr": "Un visiteur peut remplir son panier sans compte ; rien n'est écrit en base tant qu'il n'est pas connecté.",
        "en": "Visitors can fill a cart without an account; nothing is written to the database until they sign in."
      },
      "alternative": {
        "fr": "Une table Panier liée à l’utilisateur.",
        "en": "A Cart table linked to the user."
      },
      "tradeoff": {
        "fr": "Une copie du panier à tenir à jour dans le profil.",
        "en": "A copy of the cart to keep up to date in the profile."
      }
    },
    {
      "title": {
        "fr": "Profil créé par un signal",
        "en": "Profile created by a signal"
      },
      "why": {
        "fr": "Chaque utilisateur a son profil dès l'inscription, sans toucher au modèle User de Django.",
        "en": "Every user gets a profile at sign-up, without touching Django's User model."
      },
      "alternative": {
        "fr": "Un modèle utilisateur personnalisé.",
        "en": "A custom user model."
      },
      "tradeoff": {
        "fr": "Une requête de plus pour lire le profil.",
        "en": "One more query to read the profile."
      }
    },
    {
      "title": {
        "fr": "Administration de Django",
        "en": "Django admin"
      },
      "why": {
        "fr": "Le catalogue, les formateurs et les profils se gèrent sans écrire d'écran d'administration.",
        "en": "The catalogue, trainers and profiles are managed without writing admin screens."
      },
      "alternative": {
        "fr": "Un back-office fait main.",
        "en": "A hand-made back office."
      },
      "tradeoff": {
        "fr": "Une interface générique, pensée pour l'équipe et pas pour le public.",
        "en": "A generic interface, meant for the team rather than the public."
      }
    },
    {
      "title": {
        "fr": "AJAX pour le panier",
        "en": "AJAX for the cart"
      },
      "why": {
        "fr": "L'ajout se fait sans quitter la fiche de la formation ; le compteur du panier suit.",
        "en": "Adding happens without leaving the course page; the cart counter follows."
      },
      "alternative": {
        "fr": "Un formulaire classique avec redirection.",
        "en": "A classic form with a redirect."
      },
      "tradeoff": {
        "fr": "Le jeton CSRF à joindre à chaque appel.",
        "en": "The CSRF token to send with each call."
      }
    }
  ],
  "limits": {
    "fr": [
      "Pas encore de paiement : le panier s'arrête au récapitulatif et au total.",
      "Les réservations existent dans le modèle mais ne se créent pas encore depuis le site.",
