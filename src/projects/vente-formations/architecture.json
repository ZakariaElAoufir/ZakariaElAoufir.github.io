    "group": {
      "x": 300,
      "y": 20,
      "w": 1050,
      "h": 660,
      "logo": "django",
      "label": {
        "fr": "Serveur Django, :8000",
        "en": "Django server, :8000"
      }
    },
    "caption": {
      "fr": "Une seule application Django : chaque requête passe par les middlewares (session, utilisateur, CSRF), puis par une vue qui lit ou écrit la base SQLite avec l'ORM. Le panier vit dans la session et se recopie dans le profil de l'utilisateur connecté.",
      "en": "A single Django app: each request goes through the middlewares (session, user, CSRF), then a view that reads or writes the SQLite database through the ORM. The cart lives in the session and is copied into the signed-in user's profile."
    }
  },
