erDiagram
  USERS {
    bigint id PK
    varchar username UK
    varchar password "BCrypt"
    varchar role "USER, ADMIN"
    bool enabled
  }
  PRODUCTS {
    bigint id PK
    varchar name
    varchar description
    numeric price
    varchar image_url "/uploads/..."
    bool active "soft delete"
  }
  CARTS ||--o{ CART_ITEMS : holds
  CARTS {
    bigint id PK
    bigint user_id "auth_db id"
    numeric total_amount
  }
  CART_ITEMS {
    bigint id PK
    bigint cart_id FK
    bigint product_id "product_db id"
    varchar product_name "copy"
    numeric price "copy"
    int quantity
  }
  PAYMENT_TRANSACTIONS {
    bigint id PK
    bigint user_id "auth_db id"
    bigint cart_id "cart_db id"
    numeric amount
    varchar status "PENDING, SUCCESS, FAILED"
    varchar payment_method "CARD, PAYPAL, CASH"
  }
