flowchart LR
  L["POST /auth/login"] --> A["auth-service<br/>BCrypt then JWT HS256<br/>sub, userId, role"]
  A --> R["next request<br/>Authorization: Bearer"]
  R --> F{"Gateway<br/>JwtAuthenticationFilter"}
  F -- "invalid token" --> E1["401"]
  F -- "/admin without ADMIN" --> E2["403"]
  F -- "no token" --> S{"SecurityConfig"}
  S -- "/auth, /products, /uploads" --> OK
  S -- "other route" --> E3["401"]
  F -- "valid token" --> H["adds X-User-Id,<br/>X-User-Role, X-Username"]
  H --> OK["service via Eureka"]
