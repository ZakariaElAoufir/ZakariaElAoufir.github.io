  "diagrams": [
    {
      "id": "paiement",
      "title": {
        "fr": "Parcours d’un paiement",
        "en": "Journey of a payment"
      },
      "caption": {
        "fr": "payment-service ne fait pas confiance au montant envoyé par le navigateur : il relit le panier chez cart-service par OpenFeign, en recopiant les en-têtes X-User-* posés par la gateway. Le paiement est simulé : il réussit dès que le total dépasse zéro.",
        "en": "payment-service does not trust an amount sent by the browser: it reads the cart again from cart-service with OpenFeign, copying the X-User-* headers set by the gateway. Payment is simulated: it succeeds as soon as the total is above zero."
      }
    },
    {
      "id": "securite",
      "title": {
        "fr": "Contrôle d’accès",
        "en": "Access control"
      },
      "caption": {
        "fr": "Le JWT est signé par auth-service et vérifié par la gateway avec le même secret. La gateway transmet ensuite l'identité aux services sous forme d'en-têtes ; /admin est réservé au rôle ADMIN.",
        "en": "The JWT is signed by auth-service and checked by the gateway with the same secret. The gateway then passes the identity to the services as headers; /admin is kept for the ADMIN role."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Modèle de données",
        "en": "Data model"
      },
      "caption": {
        "fr": "Quatre bases séparées, sans clé étrangère entre elles : le panier garde une copie du nom, de l'image et du prix du produit, et la transaction garde l'identifiant du panier.",
        "en": "Four separate databases, with no foreign key between them: the cart keeps a copy of the product's name, picture and price, and the transaction keeps the cart's id."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Une base par service",
        "en": "One database per service"
      },
      "why": {
        "fr": "Chaque service possède ses tables : on peut faire évoluer le schéma du panier sans toucher au catalogue.",
        "en": "Each service owns its tables: the cart schema can change without touching the catalogue."
      },
      "alternative": {
        "fr": "Une base partagée avec des jointures.",
        "en": "A shared database with joins."
      },
      "tradeoff": {
        "fr": "Plus de jointures possibles : le panier recopie le nom et le prix du produit, qui peuvent ensuite diverger.",
        "en": "No more joins: the cart copies the product's name and price, which can then drift."
      }
    },
    {
      "title": {
        "fr": "JWT vérifié à la gateway",
        "en": "JWT checked at the gateway"
      },
      "why": {
        "fr": "Un seul endroit valide le jeton ; les services reçoivent X-User-Id et X-User-Role et restent simples.",
        "en": "One place validates the token; services receive X-User-Id and X-User-Role and stay simple."
      },
      "alternative": {
        "fr": "Chaque service valide lui-même le jeton (resource server).",
        "en": "Each service validates the token itself (resource server)."
      },
      "tradeoff": {
        "fr": "Les services font confiance aux en-têtes : ils ne doivent être joignables que par la gateway.",
        "en": "Services trust the headers: they must only be reachable through the gateway."
      }
    },
    {
      "title": {
        "fr": "Eureka et routes lb://",
        "en": "Eureka and lb:// routes"
      },
      "why": {
        "fr": "La gateway et les clients Feign trouvent les services par leur nom, sans adresse écrite en dur.",
        "en": "The gateway and Feign clients find services by name, with no hard-coded address."
      },
      "alternative": {
        "fr": "Les noms DNS de Docker Compose.",
        "en": "Docker Compose DNS names."
      },
      "tradeoff": {
        "fr": "Un serveur de plus à démarrer en premier.",
        "en": "One more server to start first."
      }
    },
    {
      "title": {
        "fr": "Config Server en profil native",
        "en": "Config Server with the native profile"
      },
      "why": {
        "fr": "En Docker, la configuration vient du dossier config-repo monté en lecture seule : le lancement ne dépend pas d'un dépôt Git distant.",
        "en": "In Docker, configuration comes from the config-repo folder mounted read-only: start-up does not depend on a remote Git repo."
      },
      "alternative": {
        "fr": "Un fichier application.properties par service.",
        "en": "One application.properties per service."
      },
      "tradeoff": {
        "fr": "Les services attendent que le Config Server soit prêt (healthchecks).",
        "en": "Services wait for the Config Server to be ready (healthchecks)."
      }
    },
    {
      "title": {
        "fr": "Suppression logique des produits",
        "en": "Soft delete for products"
      },
      "why": {
        "fr": "Un produit supprimé passe à active = false : les paniers et l'historique qui le citent restent cohérents.",
        "en": "A deleted product turns active = false: carts and history that mention it stay consistent."
      },
      "alternative": {
        "fr": "Supprimer la ligne.",
        "en": "Deleting the row."
      },
      "tradeoff": {
        "fr": "Le formulaire admin propose « Inactif », mais le service n'en tient pas compte : seul « Supprimer » désactive.",
        "en": "The admin form offers \"Inactif\", but the service ignores it: only \"Supprimer\" deactivates."
      }
    }
  ],
  "limits": {
    "fr": [
      "Le paiement est simulé : aucun prestataire de paiement réel n'est branché.",
      "Pas encore de page de commandes : le client voit l'historique de ses paiements.",
      "Une seule instance par service : Eureka permet d'en lancer plusieurs, mais Docker Compose n'en démarre qu'une.",
      "Les tests automatisés se limitent au démarrage de chaque service."
    ],
    "en": [
      "Payment is simulated: no real payment provider is plugged in.",
      "No orders page yet: customers see their payment history.",
      "One instance per service: Eureka allows several, but Docker Compose starts only one.",
      "Automated tests only cover each service's start-up."
    ]
  },
  "next": {
    "fr": [
      "Ajouter l'IA pour l'assistance des clients, sous forme d'un chatbot : questions sur les produits, le panier et la livraison.",
      "Brancher un vrai prestataire de paiement en mode test.",
      "Une page de suivi des commandes.",
      "Des tests d'intégration entre les services."
    ],
    "en": [
      "Add AI for customer support, as a chatbot: questions about products, the cart and delivery.",
      "Plug in a real payment provider in test mode.",
      "An order tracking page.",
      "Integration tests between the services."
    ]
  }
}