  "diagrams": [
    {
      "id": "parcours",
      "title": {
        "fr": "Parcours d'une question",
        "en": "Journey of a question"
      },
      "caption": {
        "fr": "Deux garde-fous évitent les réponses inventées : le filtre de mots-clés refuse les questions hors agriculture avant tout appel au modèle, et le seuil de distance FAISS refuse de répondre quand aucun extrait n'est assez proche.",
        "en": "Two safeguards prevent made-up answers: the keyword filter refuses non-farming questions before any model call, and the FAISS distance threshold refuses to answer when no excerpt is close enough."
      }
    },
    {
      "id": "indexation",
      "title": {
        "fr": "Indexation des PDF",
        "en": "PDF indexing"
      },
      "caption": {
        "fr": "Faite une seule fois : au démarrage suivant, l'index et les extraits sont rechargés depuis le disque.",
        "en": "Done only once: on the next start, the index and the excerpts are loaded back from disk."
      }
    },
    {
      "id": "donnees",
      "title": {
        "fr": "Modèle de données",
        "en": "Data model"
      },
      "caption": {
        "fr": "Une conversation regroupe ses messages ; la barre latérale affiche chaque conversation par sa première question.",
        "en": "A conversation groups its messages; the sidebar shows each conversation by its first question."
      }
    }
  ],
  "choices": [
    {
      "title": {
        "fr": "Ollama, en local",
        "en": "Ollama, running locally"
      },
      "why": {
        "fr": "Aucune donnée ne sort de la machine, aucun coût par requête, et le modèle se change d'une ligne.",
        "en": "No data leaves the machine, no cost per request, and the model changes in one line."
      },
      "alternative": {
        "fr": "Une API hébergée (OpenAI, Mistral) : réponses meilleures, mais payantes et dépendantes du réseau.",
        "en": "A hosted API (OpenAI, Mistral): better answers, but paid and network-dependent."
      },
      "tradeoff": {
        "fr": "llama3.2:3b est léger : réponses plus courtes et parfois moins précises qu'un grand modèle.",
        "en": "llama3.2:3b is small: shorter and sometimes less precise answers than a large model."
      }
    },
    {
      "title": {
        "fr": "FAISS IndexFlatL2",
        "en": "FAISS IndexFlatL2"
      },
      "why": {
        "fr": "Recherche exacte, sans réglage ; avec 275 extraits, elle reste instantanée.",
        "en": "Exact search with no tuning; with 275 excerpts it stays instant."
      },
      "alternative": {
        "fr": "Une base vectorielle (Chroma, pgvector) ou un index approché (IVF, HNSW).",
        "en": "A vector database (Chroma, pgvector) or an approximate index (IVF, HNSW)."
      },
      "tradeoff": {
        "fr": "Index figé : ajouter un PDF oblige à le reconstruire.",
        "en": "Frozen index: adding a PDF means rebuilding it."
      }
    },
    {
      "title": {
        "fr": "Deux garde-fous",
        "en": "Two safeguards"
      },
      "why": {
        "fr": "Un filtre de mots-clés et un seuil de distance (190) empêchent le modèle de répondre hors de ses documents.",
        "en": "A keyword filter and a distance threshold (190) stop the model from answering outside its documents."
      },
      "alternative": {
        "fr": "Un classifieur de domaine ou un reranker.",
        "en": "A domain classifier or a reranker."
      },
      "tradeoff": {
        "fr": "Les deux valeurs sont écrites en dur et le filtre peut refuser une question agricole formulée sans mot-clé de la liste.",
        "en": "Both values are hard-coded, and the filter can refuse a farming question worded without a listed keyword."
      }
    },
    {
      "title": {
        "fr": "FastAPI + Streamlit + SQLite",
        "en": "FastAPI + Streamlit + SQLite"
      },
      "why": {
        "fr": "L'API sépare la logique RAG de l'interface ; Streamlit donne un chat en quelques lignes ; SQLite garde l'historique sans serveur.",
        "en": "The API keeps the RAG logic apart from the interface; Streamlit gives a chat in a few lines; SQLite keeps the history without a server."
      },
      "alternative": {
        "fr": "Un front web dédié et PostgreSQL.",
        "en": "A dedicated web front end and PostgreSQL."
      },
      "tradeoff": {
        "fr": "Mono-utilisateur, sans authentification.",
        "en": "Single-user, without authentication."
      }
    }
  ],
  "limits": {
    "fr": [
      "Pas d'authentification ni de gestion des utilisateurs.",
      "Ollama doit tourner pour toute nouvelle question.",
      "Corpus figé : un nouveau PDF impose de régénérer l'index.",
      "Erreurs réseau et délais d'Ollama peu gérés par l'API."
    ],
    "en": [
      "No authentication or user management.",
      "Ollama must be running for any new question.",
      "Frozen corpus: a new PDF means regenerating the index.",
      "Network errors and Ollama delays are barely handled by the API."
    ]
  },
  "next": {
    "fr": [
      "Commande d'ingestion pour reconstruire l'index.",
      "Tests automatisés et gestion d'erreurs claire.",
      "Citation des extraits exacts, pas seulement des fichiers.",
      "Authentification et déploiement en conteneurs."
    ],
    "en": [
      "An ingestion command to rebuild the index.",
      "Automated tests and clear error handling.",
      "Quoting the exact excerpts, not only the files.",
      "Authentication and container deployment."
    ]
  }
}
