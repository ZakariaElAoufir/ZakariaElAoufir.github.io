---
// Top of a project's demo and architecture pages: breadcrumb, title, type and date, Demo | Architecture tabs, code link.
import Icon from '../Icon.astro';
import type { Project } from '../../lib/projects';
import { localePath, pick, useTranslations, type Key, type Lang } from '../../i18n/utils';

interface Props { lang: Lang; project: Project; current: 'demo' | 'architecture' }
const { lang, project: { id, data }, current } = Astro.props;
const t = useTranslations(lang);
const typeLabel: Record<string, Key> = { stage: 'projects.typeStage', personnel: 'projects.typePersonnel', academique: 'projects.typeAcademique' };
const tabs = [
  { key: 'demo', href: localePath(lang, `/projets/${id}/`), label: t('project.tabDemo'), icon: 'play' },
  { key: 'architecture', href: localePath(lang, `/projets/${id}/architecture/`), label: t('project.tabArchitecture'), icon: 'layers' }
];
---
<div class="instant head">
  <p class="crumbs reveal"><a href={`${localePath(lang, '/projets/')}#${id}`}>{t('nav.projects')}</a><span>/</span><span>{pick(data.shortTitle, lang)}</span></p>
  <h1 class="big reveal" style="--d:100ms">{pick(data.title, lang)}</h1>
  <div class="tags reveal" style="--d:180ms">
    <span class={`type ${data.type}`}>{t(typeLabel[data.type])}{data.company && ` · ${data.company}`}{data.pair && ` · ${t('projects.pair')}`}</span>
    <span class="date"><Icon name="calendar" />{pick(data.period, lang)}</span>
  </div>
  <nav class="tabs reveal" style="--d:240ms">
    {tabs.map(tab => <a class="tab" href={tab.href} aria-current={tab.key === current ? 'page' : undefined}><Icon name={tab.icon} />{tab.label}</a>)}
    {data.repo
      ? <a class="btn small ghost code" href={data.repo}><Icon name="code" />{t('projects.code')}</a>
      : <span class="private code"><Icon name="lock" />{t('projects.private')}</span>}
  </nav>
</div>

<style>
  .crumbs { display: flex; gap: 10px; font: 500 15px/1 var(--display); color: var(--ash); }
  .crumbs a:hover { color: var(--accent-text); }
  .big { margin: 18px 0; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .type { display: inline-flex; padding: 6px 12px; font: 600 15px/1 var(--display); letter-spacing: .04em; text-transform: uppercase; clip-path: var(--pix); }
  .type.stage { background: var(--accent); }
  .type.personnel { background: var(--ivory); color: var(--night); }
  .type.academique { background: var(--raise); box-shadow: inset 0 0 0 4px var(--line); }
  .date { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; color: var(--ash); }
  .tabs { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 32px; }
  .tab { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px 14px; font: 700 16px/1 var(--display); text-transform: uppercase; background: var(--deep); clip-path: var(--pix); color: var(--ash); transition: background .2s, color .2s; }
  .tab[aria-current] { background: var(--accent); color: var(--ivory); box-shadow: inset 0 -4px 0 var(--accent-dark); }
  .tab:hover:not([aria-current]) { color: var(--ivory); background: var(--raise); }
  .code { margin-left: auto; }
  @media (max-width: 960px) { .code { margin-left: 0; } }
</style>
