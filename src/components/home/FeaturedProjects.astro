---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { publishedProjects } from '../../lib/projects';
import { localePath, pick, useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = (await publishedProjects()).filter(p => p.data.featured && p.data.card);
const projectsPage = localePath(lang, '/projets/');
---
<section class="block" id="projets">
  <h2 class="big reveal">{t('home.projects')}</h2>
  <div class="towers">
    {featured.map(({ id, data }, i) => {
      const name = pick(data.shortTitle, lang);
      const demo = data.hasDemo ? localePath(lang, `/projets/${id}/`) : null;
      return (
        <article class="proj px-frame reveal" style={`--d:${i * 120}ms`}>
          <a class:list={['facade', { shot: data.thumbnail }]} href={demo ?? `${projectsPage}#${id}`} aria-label={t('home.openProject', { name })}>
            {data.thumbnail && <Image src={data.thumbnail} alt="" widths={[400, 800]} sizes="(max-width: 960px) 90vw, 400px" />}
            <strong>{name}</strong>
            {demo && <em><Icon name="play" />{t('projects.seeDemo')}</em>}
          </a>
          <div class="body">
            <p class="years">{pick(data.period, lang)}</p>
            <h3>{pick(data.card!.title, lang)}</h3>
            <p>{pick(data.card!.summary, lang)}</p>
            <div class="chips">{data.card!.stack.map(s => <span>{s}</span>)}</div>
            <div class="links">
              {demo && <a href={demo}><Icon name="play" />{t('projects.demo')}</a>}
              {data.hasDemo && <a href={localePath(lang, `/projets/${id}/architecture/`)}><Icon name="layers" />{t('projects.architecture')}</a>}
              {data.repo
                ? <a href={data.repo}><Icon name="code" />{t('projects.code')}</a>
                : <span class="private"><Icon name="lock" />{t('projects.private')}</span>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <div class="all reveal"><a class="btn ghost" href={projectsPage}>{t('home.allProjects')}<Icon name="arrow" /></a></div>
</section>

<style>
  .towers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; align-items: end; }
  .proj { display: flex; flex-direction: column; background: var(--deep); padding-top: 20px; }
  .proj:nth-child(2) { margin-bottom: 60px; }
  .proj:hover { transform: translateY(-8px); background: var(--raise); --frame: var(--accent-text); }
  /* a lit facade drawn in CSS stands in for the project picture */
  .facade { position: relative; display: block; aspect-ratio: 4 / 3; margin: 0 20px; background: var(--night); overflow: hidden; clip-path: var(--pix); }
  .facade::before { content: ""; position: absolute; inset: 0; transition: opacity .6s; background:
    linear-gradient(90deg, transparent 0 46%, var(--deep) 46% 54%, transparent 54%),
    repeating-linear-gradient(90deg, rgba(80, 80, 220, .14) 0 10%, transparent 10% 14%),
    repeating-linear-gradient(0deg, var(--night) 0 6%, transparent 6% 14%); }
  .proj:hover .facade::before { opacity: .4; }
  /* a project with a demo shows a screenshot of it, zoomed in a little on hover */
  .facade.shot::before { display: none; }
  .facade img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: left top; transition: transform .8s var(--ease), filter .4s; }
  .facade.shot::after { content: ""; position: absolute; inset: 0; background: linear-gradient(transparent 40%, rgba(18, 18, 47, .92)); }
  .proj:hover .facade img { transform: scale(1.06); filter: brightness(.75); }
  .facade strong { z-index: 1; }
  .facade em { position: absolute; z-index: 2; top: 14px; right: 14px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--accent); clip-path: var(--pix); font: 700 14px/1 var(--display); font-style: normal; text-transform: uppercase; opacity: 0; transform: translateY(-8px); transition: opacity .3s, transform .35s var(--ease); }
  .proj:hover .facade em, .facade:focus-visible em { opacity: 1; transform: none; }
  .facade strong { position: absolute; left: 18px; bottom: 16px; right: 18px; font: 700 24px/1 var(--display); text-transform: uppercase; }
  .body { padding: 26px 28px 30px; display: flex; flex-direction: column; flex: 1; }
  .years { font: 600 16px/1 var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
  h3 { font: 600 22px/1.2 var(--text); margin: 10px 0; }
  .body > p:not(.years) { color: var(--ash); font-size: 16px; }
  .chips { margin-top: 16px; }
  .links { margin-top: auto; padding-top: 22px; }
  .all { display: flex; justify-content: center; margin-top: 56px; }
  @media (max-width: 960px) {
    .towers { grid-template-columns: 1fr; }
    .proj:nth-child(2) { margin-bottom: 0; }
  }
</style>
