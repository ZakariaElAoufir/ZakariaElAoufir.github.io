---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Icon from '../Icon.astro';
import portrait from '../../assets/profile.png';
import { localePath, pick, useTranslations, type Lang } from '../../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = (await getEntry('profile', 'profile'))!.data;
---
<section class="hero instant">
  <div>
    <p class="role reveal" style="--d:100ms">{pick(p.role, lang)}</p>
    <h1 class="reveal" style="--d:220ms"><span>{p.firstName}</span><span>{p.lastName}</span></h1>
    <p class="status px-frame reveal" style="--d:400ms"><i></i>{pick(p.status, lang)}</p>
    <p class="summary reveal" style="--d:500ms">{pick(p.summary, lang)}</p>
    <div class="actions reveal" style="--d:600ms">
      <a class="btn" href={localePath(lang, '/projets/')}>{t('home.seeProjects')}<Icon name="arrow" /></a>
      <a class="btn ghost" href={t('cv.file')} download><Icon name="download" />{t('cv.download')}</a>
    </div>
    <div class="socials reveal" style="--d:700ms">
      <a href={p.github}><Icon name="github" />GitHub</a>
      <a href={p.linkedin}><Icon name="linkedin" />LinkedIn</a>
      <a href={`mailto:${p.email}`}><Icon name="mail" />{t('footer.email')}</a>
    </div>
  </div>
  <figure class="portrait px-frame reveal" style="--d:300ms">
    <Image src={portrait} alt={t('home.portraitAlt')} widths={[300, 600]} sizes="300px" loading="eager" />
  </figure>
</section>

<style>
  .hero { min-height: 100svh; padding: 130px var(--margin) 80px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: clamp(32px, 6vw, 96px); max-width: 1440px; margin: 0 auto; }
  .role { font: 600 clamp(16px, 1.4vw, 19px)/1.3 var(--display); letter-spacing: .06em; text-transform: uppercase; color: var(--accent-text); }
  h1 { font: 800 clamp(52px, 8.4vw, 132px)/.95 var(--name); letter-spacing: -.01em; text-transform: uppercase; margin: 18px 0 30px; text-shadow: .05em .05em 0 var(--accent-dark); }
  h1 span { display: block; }
  h1 span + span { color: var(--accent-text); }
  .status { display: inline-flex; align-items: center; gap: 12px; padding: 9px 16px; background: var(--raise); font-size: 15px; }
  .status i { width: 9px; height: 9px; background: var(--accent-text); animation: blink 1.6s steps(2) infinite; }
  @keyframes blink { 50% { opacity: .25; } }
  .summary { max-width: 54ch; margin: 22px 0 32px; font-size: 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .socials { display: flex; gap: 22px; margin-top: 30px; font-size: 15px; }
  .socials a { display: inline-flex; align-items: center; gap: 8px; color: var(--ash); transition: color .2s; }
  .socials a:hover { color: var(--accent-text); }

  /* the portrait: a CV-size square, the photo left exactly as it is */
  .portrait { width: clamp(220px, 21vw, 300px); padding: 12px; background: var(--deep); margin: 0; }
  .portrait:hover { --frame: var(--accent-text); transform: translate(-4px, -4px); }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: center 22%; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; padding-top: 110px; }
    .portrait { order: -1; width: min(200px, 60%); margin: 10px 0 12px 8px; }
  }
</style>
